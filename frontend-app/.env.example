# ============================================================
# KTS Smart Agriculture — Frontend Environment Variables
# ============================================================
# Copy file này thành .env và điền giá trị thực sau khi deploy backend

# Cognito — lấy từ SAM Outputs: UserPoolId và UserPoolClientId
VITE_COGNITO_USER_POOL_ID=ap-southeast-1_XXXXXXXXX
VITE_COGNITO_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# API Base URL — dùng CloudFront domain (SAM Output: CloudFrontDomain)
# Format: https://<cloudfront-domain>/prod
# Hoặc API Gateway trực tiếp: https://<api-id>.execute-api.<region>.amazonaws.com/prod
VITE_API_BASE_URL=https://xxxxxxxxxxxxxx.cloudfront.net/prod
